{
  "name": "transformmynotes",
  "version": "1.98.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:marketing": "npm run dev -w @transformmynotes/marketing",
    "dev:application": "npm run dev -w @transformmynotes/application",
    "lint": "npm run lint --workspaces --if-present",
    "lint:application": "npm run lint -w @transformmynotes/application",
    "lint:marketing": "npm run lint -w @transformmynotes/marketing",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:application": "playwright test --config playwright.application.config.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1094.0",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/s3rver": "^3.7.4",
    "cognito-local": "^5.3.0",
    "s3rver": "^3.7.1",
    "sst": "^4.17.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
